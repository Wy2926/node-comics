# Independent outputs: --target website|admin --output type=local,dest=...
FROM node:22-bookworm-slim AS admin-build
WORKDIR /admin-ui
COPY admin-ui/package*.json ./
RUN npm ci
COPY admin-ui ./
RUN npm run build

FROM node:22-bookworm-slim AS website-build
WORKDIR /website
COPY extension-release.json /extension-release.json
COPY website/package*.json ./
RUN npm ci
COPY website ./
COPY shared /shared
RUN npm run build

FROM scratch AS website
COPY --from=website-build /website/dist /site
COPY extension-release.json /extension-release.json

FROM scratch AS admin
COPY --from=admin-build /app/admin_web/dist /site
