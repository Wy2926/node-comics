# Repository-root context; independent --target website|admin local outputs.
FROM node:22-bookworm-slim AS admin-build
WORKDIR /workspace/backend/admin-ui
COPY backend/admin-ui/package*.json ./
RUN npm ci
COPY backend/admin-ui ./
RUN npm run build

FROM node:22-bookworm-slim AS website-build
WORKDIR /workspace/backend/website
COPY backend/extension-release.json /workspace/backend/extension-release.json
COPY backend/website/package*.json ./
RUN npm ci
COPY backend/website ./
COPY backend/shared /workspace/backend/shared
COPY backend/app/catalog_defaults.json /workspace/backend/app/catalog_defaults.json
COPY docs/images /workspace/docs/images
RUN npm run build

FROM scratch AS website
COPY --from=website-build /workspace/backend/website/dist /site
COPY backend/extension-release.json /extension-release.json

FROM scratch AS admin
COPY --from=admin-build /workspace/backend/app/admin_web/dist /site
