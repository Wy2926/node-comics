---
import LocalizedPage from '../components/LocalizedPage.astro';
import {locales,localPath,publicPaths} from '../i18n';
export function getStaticPaths() {
  return locales.flatMap(locale => [...publicPaths,'/account/','/auth/callback/'].map(path => ({params:{page:localPath(path,locale).replace(/^\/|\/$/g,'') || undefined},props:{locale,path}})));
}
const {locale,path}=Astro.props;
---
<LocalizedPage locale={locale} path={path} />
