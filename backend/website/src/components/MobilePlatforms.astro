---
import { appRelease } from '../data/app';
import { appCopy } from '../i18n/apps';
import { mobileCopy } from '../i18n/mobile';
import { localPath, type Locale } from '../i18n';
import PlatformIcon from './PlatformIcon.astro';
interface Props { locale: Locale; selected?: string }
const { locale, selected } = Astro.props;
const c = appCopy[locale];
const entries = [
  { slug: 'android-firefox', kind: 'android-firefox' as const, name: c.firefoxAndroid, detail: c.extensions },
  { slug: appRelease.androidSlug, kind: 'android-app' as const, name: 'Android App', detail: c.available },
  { slug: appRelease.iosSlug, kind: 'ios-app' as const, name: 'iOS App', detail: c.iosStatus },
];
---
<nav class="mobile-platforms" aria-label={mobileCopy[locale].label}>
  {entries.map(entry => <a class="mobile-platform" href={localPath(`/guides/${entry.slug}/`, locale)} aria-current={selected === entry.slug ? 'page' : undefined}>
    <PlatformIcon kind={entry.kind}/><span><strong>{entry.name}</strong><small>{entry.detail}</small></span><span aria-hidden="true">↗</span>
  </a>)}
</nav>
<style>
  .mobile-platforms { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-bottom: 32px; }
  .mobile-platform { display: flex; align-items: center; gap: 18px; min-width: 0; padding: 20px; border: 1px solid var(--line); border-radius: var(--comic-card-radius); background: var(--surface); }
  .mobile-platform:is(:hover, [aria-current='page']) { border-color: var(--accent); background: var(--accent-soft); }
  .mobile-platform strong { font-size: .95rem; font-weight: 600; }
  .mobile-platform small { display: block; margin-top: 6px; color: var(--muted); font-size: .76rem; }
  .mobile-platform > span:last-child { margin-inline-start: auto; color: var(--accent); }
  @media (max-width: 800px) { .mobile-platforms { grid-template-columns: 1fr; gap: 10px; } .mobile-platform { padding: 16px; } }
</style>
