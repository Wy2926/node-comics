---
import { mobilePlatforms } from '../data/mobile';
import { mobileCopy } from '../i18n/mobile';
import { localPath, type Locale } from '../i18n';
interface Props { locale: Locale; selected?: string }
const { locale, selected } = Astro.props;
const copy = mobileCopy[locale];
---
<nav class="mobile-platforms" aria-label={copy.label}>
  {mobilePlatforms.map(platform => <a class="mobile-platform" data-platform={platform.id}
    href={localPath(`/guides/${platform.slug}/`, locale)} aria-current={selected === platform.slug ? 'page' : undefined}>
    <img src={platform.icon} width="36" height="36" alt="" aria-hidden="true" />
    <span><strong>{platform.name} <span class="platform-browser">/ {platform.browser}</span></strong><small>{copy.label}</small></span>
    <span class="ui-icon icon-arrow" aria-hidden="true"></span>
  </a>)}
</nav>
<style>
  .mobile-platforms { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-bottom: 36px; }
  .mobile-platform { display: flex; align-items: center; gap: 18px; min-width: 0; padding: 22px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); transition: border-color .15s; }
  .mobile-platform:is(:hover, [aria-current='page']) { border-color: var(--accent); background: var(--accent-soft); }
  .mobile-platform > img { flex: none; object-fit: contain; }
  .mobile-platform > span:not(.ui-icon) { min-width: 0; }
  .mobile-platform strong { font-size: 1rem; font-weight: 500; }
  .platform-browser { color: var(--muted); }
  .mobile-platform small { display: block; margin-top: 6px; color: var(--accent); font-size: .8rem; }
  .mobile-platform .icon-arrow { margin-inline-start: auto; }
  @media (max-width: 600px) { .mobile-platforms { grid-template-columns: 1fr; gap: 12px; } .mobile-platform { padding: 18px; } }
</style>
