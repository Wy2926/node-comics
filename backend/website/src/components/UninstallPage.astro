---
import UninstallForm from './UninstallForm';
import {uninstallCopy} from '../i18n/uninstall';
import {dictionaries, localPath, locales, languageNames, type Locale} from '../i18n';
import {absolute} from '../data/site';
import '../styles/global.css';
import '../styles/header.css';
interface Props {locale: Locale}
const {locale} = Astro.props;
const t = uninstallCopy[locale];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>{t.title} · {languageNames[locale]}</title>
    <link rel="canonical" href={absolute(localPath('/uninstall/', locale))} />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <main class="uninstall-shell">
      <div class="uninstall-language">
        <details class="language-menu">
          <summary aria-label={dictionaries[locale].ui.language}>{languageNames[locale]} <span aria-hidden="true">⌄</span></summary>
          <nav aria-label={dictionaries[locale].ui.language}>{locales.map(language => <a href={localPath('/uninstall/', language)} lang={language} aria-current={locale === language ? 'true' : undefined}>{languageNames[language]}</a>)}</nav>
        </details>
      </div>
      <p class="eyebrow">NODELANE COMICS</p>
      <h1>{t.title}</h1>
      <p class="uninstall-description">{t.description}</p>
      <UninstallForm locale={locale} client:load/>
    </main>
  </body>
</html>
