---
import { getImage } from 'astro:assets';
import { browserStores } from '../data/site';
import { publishedLite } from '../data/published-lite';
import { dictionaries, localPath, type Locale } from '../i18n';
import { homeCopy } from '../i18n/home';
import { translationCopy } from '../i18n/translate';
import { billingCopy } from '../lib/billing';
import { pricingCopy, publishedPricingCopy } from '../lib/pricing';
import { comparisonRows } from '../lib/pricing-comparison';
import { publishedAmountParts, publishedAnnualDiscount } from './PublishedLitePricing';
import PriceAmount from './PriceAmount';
import comparisonZh from '../../../../docs/images/translation-comparison.png';
import comparisonEn from '../../../../docs/images/en/translation-comparison.png';
import '../styles/home.css';

interface Props { locale: Locale }
const { locale } = Astro.props;
const h = homeCopy[locale];
const t = dictionaries[locale].ui;
const href = (path: string) => localPath(path, locale);
const billing = billingCopy(locale);
const published = publishedPricingCopy(locale);
const rows = comparisonRows(locale, publishedLite.hourlyImageLimit).filter(row => row.key !== 'early');
const screenshot = locale.startsWith('zh') ? comparisonZh : comparisonEn;
const previewWidths = [640, 1120, 1680];
const previews = await Promise.all(previewWidths.map(width =>
  getImage({ src: screenshot, width, format: 'webp', quality: 85 })
));
---
<div class="product-home">
  <section class="home-hero container" aria-labelledby="home-title">
    <div class="home-copy">
      <h1 id="home-title">{h.title[0]}<span>{h.title[1]}</span></h1>
      <p class="home-description">{h.galleryBodies[5]}</p>
      <a class="button home-install" data-install-extension href={href('/download/')}>
        {h.install}<span class="button-arrow" aria-hidden="true"><span class="ui-icon icon-arrow"></span></span>
      </a>
      <a class="home-try" href={href('/translate/')}>{translationCopy[locale].open}<span class="ui-icon icon-arrow" aria-hidden="true"></span></a>
      <nav class="hero-stores" aria-label={t.storeHeading}>
        {browserStores.map(store => <a class="hero-store" data-browser={store.id}
          href={store.url || href('/download/') + '#' + store.id}
          target={store.url ? '_blank' : undefined} rel={store.url ? 'noopener noreferrer' : undefined}>
          <img src={store.icon} alt="" aria-hidden="true" width="44" height="44" />
          <span>{store.name.replace('Google ', '').replace('Microsoft ', '').replace('Mozilla ', '')}</span>
        </a>)}
      </nav>
      <p class="home-access">{h.readerAccess}</p>
    </div>
    <figure class="home-preview" id="see-it">
      <span class="home-anchor" id="translation" aria-hidden="true"></span>
      <a class="home-screenshot" href={screenshot.src} target="_blank" rel="noopener noreferrer" aria-label={h.enlarge}>
        <img src={previews[1].src} srcset={previews.map((preview, index) => preview.src + ' ' + previewWidths[index] + 'w').join(', ')} sizes="(max-width: 900px) calc(100vw - 36px), (max-width: 1440px) 56vw, 790px" alt={h.galleryAlt[5]} width={screenshot.width} height={screenshot.height} loading="eager" fetchpriority="high" decoding="async" />
      </a>
      <figcaption>{h.screenshotNote}</figcaption>
    </figure>
  </section>

  <section class="container home-service" aria-labelledby="home-service-title">
    <div class="home-service-heading">
      <h2 id="home-service-title">{h.privacyTitle}</h2><p>{h.readerAccess}</p>
      <a class="text-link home-pricing-link" href={href('/pricing/')}>{h.pricing}<span class="ui-icon icon-arrow" aria-hidden="true"></span></a>
    </div>
    <div class="home-membership">
      <div class="billing-cycle-picker home-cycle-picker">
      <fieldset class="billing-cycle billing-cycle-segmented home-cycle">
        <legend>{billing.plan}</legend>
        {(['month','year'] as const).map((interval,index) => <label class="billing-cycle-card" data-selected={index === 0}>
          <input type="radio" name="home-billing-cycle" value={interval} checked={index === 0} />
          <strong>{index === 0 ? published.monthly : published.yearly}</strong>
        </label>)}
      </fieldset>
      <p class="billing-cycle-saving"><span class="annual-badge">{pricingCopy(locale).save(publishedAnnualDiscount)}</span></p>
      </div>
      <div class="home-plans">
        <article class="home-plan">
          <h3>{t.freePlan}</h3>
          <p class="home-price"><PriceAmount parts={publishedAmountParts('free', locale)} /></p>
          <ul>{rows.map(row => <li data-feature={row.key} data-shared={row.shared}>{row.shared && <span class="ui-icon icon-check" aria-hidden="true"></span>}<span>{row.free}</span></li>)}</ul>
          <a class="button secondary" data-install-extension href={href('/download/')}>{h.install}<span class="ui-icon icon-arrow" aria-hidden="true"></span></a>
        </article>
        <article class="home-plan home-plan-lite">
          <h3>Lite</h3>
          {(['month','year'] as const).map(interval => <p class="home-price" data-home-price={interval} hidden={interval !== 'month'}><PriceAmount parts={publishedAmountParts(interval, locale)} /><small>/ {interval === 'month' ? billing.month : billing.year}</small></p>)}
          <ul>{rows.map(row => <li data-feature={row.key} data-shared={row.shared}><span class="ui-icon icon-check" aria-hidden="true"></span>{row.shared ? <span>{row.lite}</span> : <strong>{row.lite}</strong>}</li>)}</ul>
          <a class="button" href={href('/pricing/')}>{t.pricing}<span class="ui-icon icon-arrow" aria-hidden="true"></span></a>
        </article>
      </div>
      <p class="home-billing-note" data-home-price="month">{billing.renew(false)} {published.tax}</p>
      <p class="home-billing-note" data-home-price="year" hidden>{billing.renew(true)} {published.tax}</p>
    </div>
  </section>
</div>
<script>
  const cycle = document.querySelector('.home-cycle');
  cycle?.addEventListener('change', event => {
    if (!(event.target instanceof HTMLInputElement)) return;
    const interval = event.target.value;
    cycle.querySelectorAll('label').forEach(label => {
      label.dataset.selected = String(label.querySelector('input')?.value === interval);
    });
    document.querySelectorAll<HTMLElement>('[data-home-price]').forEach(price => {
      price.hidden = price.dataset.homePrice !== interval;
    });
  });
</script>
