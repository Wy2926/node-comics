---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BrowserStores from './BrowserStores.astro';
import SitesCarousel from './SitesCarousel.astro';
import { browserStores } from '../data/site';
import { homeSamples, homeSampleLanguage, homeSampleLanguages, type HomeSampleKind } from '../data/home-samples';
import { dictionaries, localPath, type Locale } from '../i18n';
import { languageNames, locales } from '../i18n/locales';
import { homeCopy } from '../i18n/home';
import { galleryCopy, showcaseCopy } from '../i18n/home/showcase';
import '../styles/home.css';

interface Props { locale: Locale }
const { locale } = Astro.props;
const h = homeCopy[locale];
const c = showcaseCopy[locale];
const g = galleryCopy[locale];
const t = dictionaries[locale].ui;
const href = (path: string) => localPath(path, locale);
const sources = import.meta.glob<{ default: ImageMetadata }>('../assets/home/*.{png,jpg,webp}', { eager: true });
async function picture(name: string, widths: number[]) {
  const source = sources[`../assets/home/${name}`]?.default;
  if (!source) throw new Error(`Missing homepage image: ${name}`);
  const images = await Promise.all(widths.map(width => getImage({ src: source, width, format: 'webp', quality: 85 })));
  return { src: images[images.length - 1].src, srcset: images.map((image, index) => `${image.src} ${widths[index]}w`).join(', '), width: source.width, height: source.height, full: source.src };
}
type Picture = Awaited<ReturnType<typeof picture>>;
const imageProps = ({ full: _full, ...image }: Picture) => image;
const language = homeSampleLanguage('mono', locale);
const [inlineOriginal, inlineTranslated, search] = await Promise.all([
  picture('inline-original.png', [640, 1120, 1440]), picture('inline-translated.png', [640, 1120, 1440]),
  picture('search.png', [640, 1120, 1384]),
]);
const sampleKinds = Object.keys(homeSamples) as HomeSampleKind[];
const samples = Object.fromEntries(await Promise.all(sampleKinds.map(async kind => {
  const source = homeSamples[kind];
  const [original, translations] = await Promise.all([
    picture(source.original, source.widths),
    Promise.all(homeSampleLanguages(kind).map(async lang => [lang, await picture(`${kind}-${lang}.webp`, source.widths)])),
  ]);
  return [kind, { original, language: languageNames[source.sourceLocale], sourceLocale: source.sourceLocale, translations: Object.fromEntries(translations) as Record<string, Picture> }];
}))) as Record<HomeSampleKind, { original: Picture; language: string; sourceLocale: Locale; translations: Record<string, Picture> }>;
const monoOriginal = samples.mono.original;
const translated = samples.mono.translations[language];
const comparisonSizes = '(max-width: 600px) calc(100vw - 68px), (max-width: 1000px) calc((100vw - 134px) / 2), (max-width: 1100px) calc((100vw - 400px) / 2), (max-width: 1440px) calc((100vw - 456px) / 2), 492px';
const chromeIcon = browserStores.find(store => store.id === 'chrome')!.icon;
---
<div class="product-home" data-home-showcase data-language={language} data-sample="mono" data-locale={locale}>
  <section class="home-hero container" aria-labelledby="home-title">
    <div class="home-copy">
      <p class="home-eyebrow">{h.eyebrow}</p>
      <h1 id="home-title">{c.title[0]}<span>{c.title[1]}</span></h1>
      <p class="home-description">{c.description}</p>
      <a class="button home-install" data-install-extension href={href('/download/')}>
        <img data-install-icon src={chromeIcon} alt="" aria-hidden="true" width="28" height="28" />
        {h.install}<span class="ui-icon icon-arrow" aria-hidden="true"></span>
      </a>
      <BrowserStores locale={locale} />
      <p class="home-access">{h.readerAccess}</p>
    </div>
    <figure class="home-preview" id="see-it">
      <div class="home-inline-comparison" data-inline-comparison>
        <a class="home-screenshot" href={inlineTranslated.src} target="_blank" rel="noopener noreferrer" aria-label={h.enlarge}>
          <img {...imageProps(inlineTranslated)} sizes="(max-width: 900px) calc(100vw - 40px), (max-width: 1440px) calc(100vw - 120px), 1280px" alt={c.description} loading="eager" fetchpriority="high" decoding="async" data-inline-image />
        </a>
        <div class="home-inline-markers" aria-hidden="true"><span>{c.original}</span><span>{c.translated}</span></div>
        <input class="home-inline-range" data-home-controls hidden type="range" min="0" max="100" value="50" dir="ltr" aria-label={h.comparison.group} />
      </div>
      <p class="home-image-status home-inline-status" role="status" aria-live="polite" data-inline-status></p>
    </figure>
  </section>
  <section class="home-comparison container" id="translation" aria-labelledby="comparison-title" data-reveal>
    <header class="home-comparison-heading">
      <div><h2 id="comparison-title">{c.compare}</h2><p>{g.description}</p></div>
      <fieldset class="home-samples home-controls" data-home-controls hidden>
        <legend class="sr-only">{h.comparison.group}</legend>
        <button class="button secondary" type="button" data-sample="mono" aria-pressed="true">{c.mono}</button>
        <button class="button secondary" type="button" data-sample="color" aria-pressed="false">{c.color}</button>
      </fieldset>
    </header>
    <div class="home-gallery">
      <aside class="home-language-panel" data-home-controls hidden>
        <div class="home-language-heading"><label id="gallery-language-label" for="gallery-language">{g.languages}</label><span aria-hidden="true">{homeSampleLanguages('mono').length}</span></div>
        <div class="home-languages home-controls" role="group" aria-labelledby="gallery-language-label">
          {locales.map(lang => <button class="button secondary compact" type="button" data-language-choice={lang} lang={lang} aria-pressed={lang === language} hidden={lang === 'ja'}><bdi>{languageNames[lang]}</bdi></button>)}
        </div>
        <div class="translation-settings home-language-mobile">
          <select id="gallery-language" data-language-select>
            {locales.map(lang => <option value={lang} lang={lang} selected={lang === language} hidden={lang === 'ja'} disabled={lang === 'ja'}>{languageNames[lang]}</option>)}
          </select>
        </div>
      </aside>
      <div class="home-gallery-stage">
        <div class="home-image-pair" dir="ltr" aria-busy="false">
          <figure data-comparison="original">
            <figcaption dir={locale === 'ar' ? 'rtl' : 'ltr'}><span>{c.original}</span><bdi lang="ja" data-original-language>日本語</bdi></figcaption>
            <a href={monoOriginal.full} target="_blank" rel="noopener noreferrer" aria-label={`${g.viewImage} · ${c.original}`}><img {...imageProps(monoOriginal)} sizes={comparisonSizes} alt={`${c.original} · 日本語`} loading="lazy" decoding="async" /></a>
          </figure>
          <figure data-comparison="translated">
            <figcaption dir={locale === 'ar' ? 'rtl' : 'ltr'}><span>{c.translated}</span><bdi lang={language} data-translated-language>{languageNames[language]}</bdi></figcaption>
            <a href={translated.full} target="_blank" rel="noopener noreferrer" aria-label={`${g.viewImage} · ${c.translated}`}><img {...imageProps(translated)} sizes={comparisonSizes} alt={`${c.translated} · ${languageNames[language]}`} loading="lazy" decoding="async" /></a>
          </figure>
          <div class="home-inline-markers home-pair-mobile" aria-hidden="true"><span>{c.original}</span><span>{c.translated}</span></div>
          <input class="home-inline-range home-pair-mobile" data-home-controls hidden type="range" min="0" max="100" value="50" dir="ltr" aria-label={h.comparison.group} aria-describedby="gallery-swipe-hint" />
        </div>
        <p class="home-swipe-hint" id="gallery-swipe-hint" data-home-controls hidden>{g.hint}</p>
        <div class="home-gallery-footer">
          <p class="home-image-status" role="status" aria-live="polite" data-image-status></p>
          <button class="button secondary compact" type="button" data-image-retry hidden>{h.comparison.retry}</button>
          <div class="home-image-actions" role="group" aria-label={g.viewImage}>
            <span>{g.viewImage}</span>
            <a href={monoOriginal.full} target="_blank" rel="noopener noreferrer" data-open-original>{c.original}<span aria-hidden="true">↗</span></a>
            <a href={translated.full} target="_blank" rel="noopener noreferrer" data-open-translated>{c.translated}<span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </div>
    <noscript>
      <details class="home-gallery-fallback">
        <summary>{g.browseAll}</summary>
        {sampleKinds.map(kind => <section aria-label={c[kind]}>
          <h3>{c[kind]}</h3>
          <a href={samples[kind].original.full} target="_blank" rel="noopener noreferrer" data-gallery-original>{c.original} · <bdi>{samples[kind].language}</bdi></a>
          <ul>{homeSampleLanguages(kind).map(lang => <li><a href={samples[kind].translations[lang].full} target="_blank" rel="noopener noreferrer" data-gallery-link data-sample-key={kind} lang={lang}><bdi>{languageNames[lang]}</bdi></a></li>)}</ul>
        </section>)}
      </details>
    </noscript>
  </section>
  <section class="home-search container" aria-labelledby="search-title" data-reveal>
    <a href={search.src} target="_blank" rel="noopener noreferrer" aria-label={h.enlarge}>
      <img {...imageProps(search)} sizes="(max-width: 850px) calc(100vw - 40px), (max-width: 1440px) 58vw, 790px" alt={c.searchTitle} loading="lazy" decoding="async" />
    </a>
    <div><h2 id="search-title">{c.searchTitle}</h2><p>{c.searchBody}</p></div>
  </section>
  <section class="home-closing container" aria-labelledby="closing-title" data-reveal>
    <h2 id="closing-title">{c.cta}</h2>
    <div class="home-closing-actions">
      <a class="button home-install" data-install-extension href={href('/download/')}><img data-install-icon src={chromeIcon} alt="" aria-hidden="true" width="28" height="28" />{h.install}<span class="ui-icon icon-arrow" aria-hidden="true"></span></a>
      <a class="button secondary" href={href('/guides/')}>{t.guides}</a>
    </div>
  </section>
  <SitesCarousel locale={locale} />
  <script type="application/json" data-home-assets set:html={JSON.stringify({ samples, inline: { original: inlineOriginal, translated: inlineTranslated }, languageNames, labels: { original: c.original, translated: c.translated, loading: h.comparison.loading, error: h.comparison.error } }).replace(/</g, '\\u003c')} />
</div>
<script>
  import { setupHomeShowcase } from '../lib/home-showcase';
  setupHomeShowcase();
</script>
