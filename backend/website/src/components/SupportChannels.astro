---
import { dictionaries, type Locale } from '../i18n';
import { projectCopy } from '../i18n/project';
import { site } from '../data/site';
import '../styles/project.css';

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = projectCopy[locale];
const { ui: t } = dictionaries[locale];
---
<section class="project-support" aria-labelledby="support-channels-title">
  <h2 id="support-channels-title">{copy.supportTitle}</h2>
  <div class="project-support-grid">
    <article class="project-card">
      <h3>{t.videoTutorials}</h3>
      <p>{t.youtubeDescription}</p>
      <a class="text-link" href={site.youtube} target="_blank" rel="noopener noreferrer">{t.watchVideos} <span aria-hidden="true">↗</span></a>
    </article>
    <article class="project-card">
      <h3>{copy.questionsTitle}</h3>
      <p>{copy.questionsBody}</p>
      <a class="text-link" href={`${site.github}/issues`} target="_blank" rel="noopener noreferrer">{copy.questionsAction} <span aria-hidden="true">↗</span></a>
    </article>
    <article class="project-card">
      <h3>{copy.privateTitle}</h3>
      <p>{copy.privateBody}</p>
      <a class="text-link" href={`mailto:${site.email}`}>{copy.emailAction} <span aria-hidden="true">↗</span></a>
      <span class="project-contact-address">{site.email}</span>
    </article>
  </div>
</section>
