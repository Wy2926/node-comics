---
import type { GuideSection, Locale } from '../i18n/types';
import { localPath } from '../i18n';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { guidePresentation } from '../i18n/guide-presentation';
interface Props { section: GuideSection; index: number; locale: Locale; numbered?: boolean; image?: ImageMetadata }
const { section, index, locale, numbered, image } = Astro.props;
const headingId = `section-${index + 1}`;
---
<section class:list={{ 'illustrated-step': !!section.screenshot, 'visual-step': !!image, 'numbered-step': numbered }} aria-labelledby={headingId}>
  <div class="step-copy">
  <h2 id={headingId}>{numbered && <span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}{section.title}</h2>
  {image && <figure class="desktop-screenshot">
    <a href={image.src} target="_blank" rel="noopener" aria-label={`${section.title} · ${guidePresentation[locale].enlarge}`}>
      <Image src={image} alt={section.title} widths={[480, 800, 1200, 1440]} sizes="(max-width: 760px) calc(100vw - 36px), (max-width: 1100px) 70vw, 980px" format="webp" quality={85} loading="lazy" decoding="async" />
    </a>
    <figcaption><span>{section.title}</span><a href={image.src} target="_blank" rel="noopener">{guidePresentation[locale].enlarge} ↗</a></figcaption>
  </figure>}
  {section.paragraphs.map(text => <p>{text}</p>)}
  {section.steps && <ol>{section.steps.map(text => <li>{text}</li>)}</ol>}
  {section.code && <pre tabindex="0" aria-labelledby={headingId}><code>{section.code}</code></pre>}
  {section.table && <div class="table-wrap" tabindex="0" role="region" aria-labelledby={headingId}>
    <table aria-labelledby={headingId}>
      <thead><tr>{section.table.headers.map(header => <th scope="col">{header}</th>)}</tr></thead>
      <tbody>{section.table.rows.map(row => <tr>{row.map((cell, column) => column === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody>
    </table>
  </div>}
  {section.links && <ul class="article-links">{section.links.map(link => <li><a href={link.href.startsWith('/') ? localPath(link.href, locale) : link.href}>{link.label}</a></li>)}</ul>}
  </div>
  {section.screenshot && <figure class="guide-screenshot" data-screenshot={section.screenshot.id}>
    {section.screenshot.src
      ? <img src={section.screenshot.src} alt={section.screenshot.caption} width="1080" height="2400" loading="lazy" decoding="async" />
      : <div class="screenshot-placeholder">
          <div class="placeholder-phone" aria-hidden="true"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8" cy="9" r="1.5"/><path d="m3 17 5-5 4 4 3-3 6 6"/></svg><span>{section.screenshot.id.toUpperCase()}</span></div>
          <strong>{section.screenshot.label}</strong>
        </div>}
    <figcaption>{section.screenshot.caption}</figcaption>
  </figure>}
</section>
<style>
  section { margin-bottom: 2.5rem; min-width: 0; overflow-wrap: anywhere; }
  h2 { scroll-margin-top: 8rem; }
  pre { padding: 1.25rem; overflow-x: auto; border: var(--comic-badge-border); border-radius: var(--comic-card-radius); background: var(--surface-soft); font-size: .875rem; line-height: 1.7; }
  code { font-family: Consolas, monospace; }
  table { min-width: 32rem; font-size: .9375rem; line-height: 1.7; }
  th, td { vertical-align: top; padding: 1rem; }
  th[scope="row"] { width: 25%; background: transparent; font-weight: 600; }
  .article-links { font-size: 1rem; }
  .illustrated-step { display: grid; grid-template-columns: minmax(0, 1fr) minmax(180px, .7fr); gap: 32px; align-items: center; padding-block: 32px; border-top: 1px solid var(--line); }
  .step-copy { min-width: 0; }
  .numbered-step { padding-top: 30px; margin-bottom: 42px; border-top: 1px solid var(--line); }
  .numbered-step h2 { display: flex; align-items: baseline; gap: 14px; line-height: 1.6; letter-spacing: -.02em; }
  .step-number { flex-shrink: 0; font: .75rem ui-monospace, monospace; color: var(--accent); }
  .numbered-step ol { padding-inline-start: 24px; }
  .numbered-step li { padding-inline-start: 8px; }
  .numbered-step li::marker { color: var(--accent); font-weight: 600; }
  .desktop-screenshot { margin: 22px 0 28px; }
  .desktop-screenshot > a { display: block; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: var(--surface-soft); }
  .desktop-screenshot img { width: 100%; height: auto; }
  .desktop-screenshot figcaption { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; margin-top: 12px; color: var(--muted); font-size: .72rem; line-height: 1.65; }
  .desktop-screenshot figcaption a { flex-shrink: 0; text-decoration: none; }
  @media (max-width: 600px) { .desktop-screenshot figcaption { flex-wrap: wrap; gap: 5px; } .numbered-step { margin-bottom: 28px; } }
  .guide-screenshot { margin: 0; min-width: 0; }
  .screenshot-placeholder { display: grid; justify-items: center; gap: 16px; padding: 24px; border: 1px dashed #526880; border-radius: var(--comic-panel-radius); background: linear-gradient(145deg, var(--surface-soft), var(--surface)); }
  .placeholder-phone { width: 136px; height: 190px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 22px; border: 1px solid #526880; border-radius: 20px; color: var(--accent); }
  .placeholder-phone span { font: .65rem ui-monospace, monospace; letter-spacing: .1em; }
  .screenshot-placeholder strong { text-align: center; color: var(--muted); font-size: .8rem; font-weight: 400; }
  .guide-screenshot figcaption { margin-top: 12px; color: var(--muted); font-size: .75rem; line-height: 1.6; text-align: center; }
  .guide-screenshot img { display: block; width: 100%; height: auto; max-height: 560px; object-fit: contain; border-radius: var(--comic-card-radius); }
  @media (max-width: 600px) { .illustrated-step { grid-template-columns: 1fr; gap: 16px; } .guide-screenshot { width: 100%; max-width: 330px; justify-self: center; } }
  :is(pre, .table-wrap):focus-visible { outline: var(--comic-focus-ring); outline-offset: var(--comic-focus-offset); }
</style>
