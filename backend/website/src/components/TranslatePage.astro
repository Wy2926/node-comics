---
import Base from '../layouts/Base.astro';
import TranslationWorkbench from './TranslationWorkbench';
import { translationCopy } from '../i18n/translate';
import { workbenchCopy } from '../i18n/workbench';
import type { Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = translationCopy[locale];
const workbench = workbenchCopy[locale];
---
<Base title={workbench.title} description={workbench.intro} noindex>
  <TranslationWorkbench client:load locale={locale} copy={t} workbench={workbench} />
  <noscript><p class="container translation-noscript">{t.local}</p></noscript>
</Base>
