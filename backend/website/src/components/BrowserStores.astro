---
import { browserStores } from '../data/site';
import { mobilePlatforms } from '../data/mobile';
import { mobileCopy } from '../i18n/mobile';
import { dictionaries, localPath, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = dictionaries[locale].ui;
const m = mobileCopy[locale];
const mobile = mobilePlatforms.map(platform => ({
  id: platform.id, mobile: true, name: platform.name, icon: platform.icon,
  href: localPath(`/guides/${platform.slug}/`, locale),
  detail: `${platform.browser} · ${platform.id === 'ios' ? m.iosStatus : m.label}`,
}));
const desktop = browserStores.map(store => ({
  id: store.id, mobile: false, name: store.name.replace('Google ', '').replace('Microsoft ', '').replace('Mozilla ', ''),
  icon: store.icon, href: store.url || `${localPath('/download/', locale)}#${store.id}`, detail: '',
}));
const platforms = [mobile[0], ...desktop, mobile[1]];
---
<nav class="hero-stores" dir="ltr" aria-label={`${t.download} · ${m.label}`}>
  {platforms.map(platform => <a class="hero-store" data-browser={!platform.mobile ? platform.id : undefined} data-platform={platform.mobile ? platform.id : undefined}
    href={platform.href} target={!platform.mobile && platform.href.startsWith('https:') ? '_blank' : undefined}
    rel={!platform.mobile ? 'noopener noreferrer' : undefined}>
    <img src={platform.icon} alt="" aria-hidden="true" width="36" height="36" />
    <strong>{platform.name}</strong>
    {platform.detail && <small dir="auto">{platform.detail}</small>}
  </a>)}
</nav>
