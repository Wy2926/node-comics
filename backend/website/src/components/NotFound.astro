---
import Base from '../layouts/Base.astro';
import PageIntro from './PageIntro.astro';
import {dictionaries,localPath,type Locale} from '../i18n';
interface Props {locale:Locale}
const {locale}=Astro.props;
const t=dictionaries[locale].ui;
---
<Base title={t.notFoundTitle} description={t.notFoundDescription} noindex><PageIntro eyebrow="404 / A MISSING PAGE" title={t.notFoundTitle} description={t.notFoundDescription}/><section class="container content-section"><a class="button" href={localPath('/',locale)}>{t.home} ↗</a></section></Base>
