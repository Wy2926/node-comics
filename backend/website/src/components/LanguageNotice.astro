---
import type {Locale} from '../i18n/types';
interface Props {locale:Locale;enabled?:boolean}
const {locale,enabled=true}=Astro.props;
---
<aside hidden data-language-notice data-enabled={String(enabled)} data-locale={locale} class="language-notice" aria-labelledby="language-notice-title">
  <div role="status" aria-live="polite" aria-atomic="true">
    <p id="language-notice-title" data-language-title class="language-notice-title"></p>
    <p data-language-message></p>
  </div>
  <div class="language-notice-actions"><a class="button compact" href="#"></a><button class="button compact secondary" type="button"></button></div>
</aside>
<script>import '../lib/language-notice';</script>
<style>
  .language-notice { position:fixed; inset-block-end:max(16px,env(safe-area-inset-bottom)); inset-inline-end:16px; z-index:25; width:min(400px,calc(100vw - 32px)); max-height:calc(100dvh - 32px); overflow:auto; padding:20px; background:var(--surface); border:var(--comic-border); border-radius:var(--comic-panel-radius); box-shadow:var(--comic-shadow); text-align:start; }
  .language-notice[hidden] { display:none; }
  .language-notice p { margin:0 0 16px; font-size:.9rem; line-height:1.6; }
  .language-notice .language-notice-title { margin-bottom:8px; font-size:1.1rem; font-weight:700; line-height:1.4; }
  .language-notice-actions { display:flex; flex-wrap:wrap; gap:10px; }
  .language-notice-actions .button { max-width:100%; white-space:normal; overflow-wrap:anywhere; text-align:center; }
</style>
