---
import type { Locale } from '../i18n/locales';
import { sitesCopy } from '../i18n/sites';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<span class="site-adult"><bdi>18+</bdi> {sitesCopy[locale].adult}</span>
<style>
  .site-adult { display: inline-flex; align-items: center; gap: 4px; max-width: 100%; padding: 4px 8px; border: 1px solid var(--danger); border-radius: var(--comic-control-radius); background: var(--danger-soft); color: var(--danger); font-size: .7rem; line-height: 1.4; font-weight: 650; }
</style>
