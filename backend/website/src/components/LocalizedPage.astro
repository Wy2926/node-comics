---
import { Image,getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageIntro from './PageIntro.astro';
import Compare from './Compare';
import Account from './Account';
import BillingOffers from './BillingOffers';
import hero from '../assets/journey-original.webp';
import translated from '../assets/journey-translated.webp';
import english from '../assets/journey-en.webp';
import korean from '../assets/journey-ko.webp';
import reading from '../assets/reading-corner.webp';
import {dictionaries,localPath,type Locale} from '../i18n';
import {site,absolute} from '../data/site';
interface Props {locale:Locale;path:string}
const {locale,path}=Astro.props;
const {ui:t,documents:d,account}=dictionaries[locale];
const href=(target:string)=>localPath(target,locale);
const key=path.split('/')[1];
const guide=path.startsWith('/guides/')?d.guides.find(item=>`/guides/${item.slug}/`===path):undefined;
const policy=d.policies[key];
const article=guide??policy;
const titles:Record<string,string>={features:t.seoFeaturesTitle,pricing:t.seoPricingTitle,download:t.seoDownloadTitle,guides:t.guides,faq:t.faq,help:t.help,about:t.about,changelog:t.changelog,account:t.account,auth:t.callbackTitle};
const intros:Record<string,[string,string]>={features:[t.featureHeading,t.featureDescription],pricing:[t.pricingTitle,t.pricingDescription],download:[t.downloadTitle,t.downloadDescription],guides:[t.guidesTitle,t.guidesDescription],faq:[t.faqTitle,t.faqDescription],help:[t.helpTitle,t.helpDescription],about:[t.aboutTitle,t.aboutDescription],changelog:[t.changelogTitle,t.changelogDescription],account:[t.accountTitle,t.accountDescription],auth:[t.callbackTitle,t.callbackDescription]};
const title=article?.title??titles[key]??t.seoHomeTitle;
const description=article?.description??intros[key]?.[1]??t.heroDescription;
const schema:Record<string,unknown>[]=[];
if(path==='/')schema.push({'@type':'SoftwareApplication',name:'NodeLane Comics',applicationCategory:'BrowserApplication',operatingSystem:'Windows, macOS, Linux',description:t.heroDescription,url:absolute(href('/')),inLanguage:locale,offers:{'@type':'Offer',price:'0',priceCurrency:'USD',description:t.freeBenefits[0],url:absolute(href('/pricing/'))}});
if(key==='faq')schema.push({'@type':'FAQPage',inLanguage:locale,mainEntity:d.faqs.map(item=>({'@type':'Question',name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))});
if(guide)schema.push({'@type':'Article',headline:guide.title,description:guide.description,datePublished:`${site.updated}T00:00:00+08:00`,dateModified:`${site.updated}T00:00:00+08:00`,author:{'@type':'Organization',name:'NodeLane Comics',url:absolute(href('/about/'))},publisher:{'@id':absolute('/#organization')},mainEntityOfPage:absolute(href(path)),image:absolute('/social-cover.webp'),inLanguage:locale});
const examples=path==='/'?await Promise.all([
  {id:'original',image:hero,label:'日文原图'},
  {id:'zh',image:translated,label:'中文示意'},
  {id:'en',image:english,label:'英文示意'},
  {id:'ko',image:korean,label:'韩文示意'},
].map(async ({id,image,label})=>({id,label,width:image.width,height:image.height,src:(await getImage({src:image,width:760,format:'webp',quality:88})).src}))):[];
const stores=[{name:'Google Chrome',label:'Chrome Web Store',icon:'/browsers/chrome.svg',url:site.stores.chrome},{name:'Microsoft Edge',label:'Edge Add-ons',icon:'/browsers/edge.png',url:site.stores.edge},{name:'Mozilla Firefox',label:'Firefox Add-ons',icon:'/browsers/firefox.svg',url:site.stores.firefox}];
---
<Base title={title} description={description} schema={schema} noindex={['account','auth'].includes(key)}>
  {path==='/' ? <>
    <section class="container hero"><div class="hero-copy"><p class="eyebrow"><span></span>{t.heroEyebrow}</p><h1>{t.heroLines[0]}<br/><em>{t.heroLines[1]}</em></h1><p>{t.heroDescription}</p><div class="hero-actions"><a class="button" href={href('/download/')}>{t.freeStart} <span aria-hidden="true">↗</span></a><a class="text-link" href="#see-it">{t.seeHow} ↓</a></div><div class="browser-strip"><span>{t.desktop}</span><span>Chrome</span><span>Edge</span><span>Firefox</span></div></div><figure class="hero-art"><div class="hero-frame"><Image src={hero} alt={t.heroAlt} widths={[480,760,1024]} sizes="(max-width:760px) 90vw, 480px" loading="eager" fetchpriority="high" format="webp" quality={85}/></div><span class="hero-stamp">READ BEYOND WORDS</span><div class="speech-note"><small>{t.nextStop}</small>{t.tagline} ✦</div><figcaption class="art-caption">{t.heroCaption}</figcaption></figure></section>
    <div class="feature-ribbon"><div class="container ribbon-inner">{t.ribbon.map((item,i)=><span><b aria-hidden="true">{['✦','▤','↔','⌖'][i]}</b>{item}</span>)}</div></div>
    <section class="container section"><div class="section-title"><div><p class="eyebrow">BUILT FOR YOUR NEXT PAGE</p><h2>{t.featureHeading}</h2></div><p>{t.featureDescription}</p></div><div class="feature-grid">{t.featureTitles.map((item,i)=><article class:list={['feature-card',{tint:i===1}]}><span class="number">0{i+1} / NODELANE COMICS</span><h3>{item}</h3><p>{t.featureBodies[i]}</p><a class="text-link" href={href(`/guides/${d.guides[i].slug}/`)}>{t.readGuide} ↗</a></article>)}</div></section>
    <section class="container section split" id="see-it"><div class="split-copy"><p class="eyebrow">SAME PAGE, NEW CONNECTION</p><h2>{t.compareTitle}</h2><p>{t.compareDescription}</p><ul class="check-list">{t.ribbon.map(item=><li>{item}</li>)}</ul><a class="text-link" href={href('/features/')}>{t.features} ↗</a></div><Compare client:visible examples={examples} locale={locale} copy={account??{}}/></section>
    <section class="reading-band"><div class="container section split"><div class="reading-art"><Image src={reading} alt={t.readingAlt} widths={[480,800,1100]} sizes="(max-width:760px) 90vw, 550px" loading="lazy" format="webp" quality={82}/></div><div class="split-copy"><p class="eyebrow">MAKE ROOM FOR YOUR FAVORITES</p><h2>{t.readingTitle}</h2><p>{t.readingDescription}</p><a class="text-link" href={href('/guides/local-comics/')}>{t.readGuide} ↗</a><div class="format-tags">{['CBZ / ZIP','CBR / RAR','PDF','DRM-free MOBI'].map(item=><span>{item}</span>)}</div></div></div></section>
    <section class="container section"><div class="section-title"><div><p class="eyebrow">THE READER’S NOTEBOOK</p><h2>{t.guideHeading}</h2></div><a class="text-link" href={href('/guides/')}>{t.allGuides} ↗</a></div><div class="guide-grid">{d.guides.slice(0,3).map(item=><a class="guide-card" href={href(`/guides/${item.slug}/`)}><span class="tag">{item.category} / {item.minutes} {t.minutes}</span><h3>{item.title}</h3><p>{item.description}</p><span class="read-more">{t.readGuide} ↗</span></a>)}</div></section>
  </> : <PageIntro eyebrow={guide?.category??'NODELANE COMICS / '+key.toUpperCase()} title={article?.title??intros[key]?.[0]??title} description={description}>{article&&<div class="meta"><span>{t.editor}</span><time datetime={site.updated}>{t.updated}: {site.updated}</time>{guide&&<span>{guide.minutes} {t.minutes}</span>}</div>}</PageIntro>}

  {article&&<div class="container content-section prose-layout"><nav class="toc" aria-label={t.contents}><strong>{t.contents}</strong>{article.sections.map((section,i)=><a href={`#section-${i+1}`}>{section.title}</a>)}</nav><article class="prose">{article.sections.map((section,i)=><section><h2 id={`section-${i+1}`}>{section.title}</h2>{section.paragraphs.map(text=><p>{text}</p>)}{section.steps&&<ol>{section.steps.map(text=><li>{text}</li>)}</ol>}</section>)}<aside class="note"><a href={href('/download/')}>{t.download}</a> · <a href={href('/pricing/')}>{t.pricing}</a> · <a href={href('/privacy/')}>{t.privacy}</a> · <a href={href('/help/')}>{t.help}</a></aside>{guide&&<div class="related"><h2>{t.related}</h2>{d.guides.filter(item=>item.slug!==guide.slug).slice(0,3).map(item=><a href={href(`/guides/${item.slug}/`)}>{item.title} ↗</a>)}</div>}</article></div>}
  {key==='features'&&<><section class="container content-section"><div class="feature-grid">{t.featureTitles.map((item,i)=><article class="feature-card"><span class="number">0{i+1} / NODELANE COMICS</span><h2>{item}</h2><p style="margin-top:18px">{t.featureBodies[i]}</p><a class="text-link" href={href(`/guides/${d.guides[i].slug}/`)}>{t.readGuide} ↗</a></article>)}</div></section><section class="reading-band"><div class="container section split"><div class="split-copy"><p class="eyebrow">A LITTLE LESS FRICTION</p><h2>{t.readingTitle}</h2><p>{t.readingDescription}</p><a class="text-link" href={href('/guides/local-comics/')}>{t.readGuide} ↗</a></div><div class="reading-art"><Image src={reading} width={720} format="webp" alt={t.readingAlt} loading="lazy"/></div></div></section><div class="section"></div></>}
  {key==='pricing'&&<section class="container content-section"><div class="pricing-grid"><article class="price-card"><div class="membership-heading"><span class="membership-icon" aria-hidden="true"><svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg></span><span>READ EVERY DAY</span></div><h2>{t.freePlan}</h2><p>{t.freePlanDescription}</p><p class="price"><small>US$</small>0 <span>/ {t.free}</span></p><ul class="check-list">{t.freeBenefits.map(item=><li>{item}</li>)}</ul><a class="button secondary" href={href('/download/')}>{t.freeStart} ↗</a><p class="trial-note">{t.freeNote}</p></article><article class="price-card plus"><div class="membership-heading"><span class="membership-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="m3 6 5 4 4-7 4 7 5-4-3 12H6L3 6Z"/><path d="M6 21h12"/></svg></span><span>MORE STORIES, MORE POSSIBILITIES</span><b>PLUS</b></div><h2>PLUS</h2><p>{t.plusDescription}</p><BillingOffers client:load locale={locale} accountHref={href('/account/')} benefits={t.plusBenefits.slice(2)}/></article></div><div class="faq-list"><h2>{t.pricing}</h2><p class="note">{t.quotaNote}</p><a class="text-link" href={href('/refund/')}>{t.refund} ↗</a></div></section>}
  {key==='download'&&<section class="container content-section"><article class="help-card direct-download" aria-labelledby="direct-download-title"><div><p class="eyebrow">CHROME / EDGE</p><h2 id="direct-download-title">{t.directDownloadTitle}</h2><p>{t.directDownloadDescription}</p><a class="button" href={site.extensionRelease.path} download={site.extensionRelease.filename}>{t.downloadZip} ↓</a><p class="note">v{site.extensionRelease.version} · {(site.extensionRelease.bytes / 1024 / 1024).toFixed(2)} MB · ZIP</p></div><div><h3>{t.installTitle}</h3><ol class="install-steps"><li>{t.installStepDownload}</li><li>{t.installStepBrowser}</li><li>{t.installStepLoad}</li></ol><p class="note">{t.manualUpdateNote}</p></div></article><p class="note">{t.firefoxDownloadNote}</p><h2 class="store-heading">{t.storeHeading}</h2><div class="store-grid">{stores.map(store=><article class="store-card"><img class="store-icon" src={store.icon} alt={store.name} width="48" height="48" loading="lazy"/><h2>{store.name}</h2><p>{t.storeDescription}</p>{store.url?<a class="button" href={store.url} target="_blank" rel="noopener noreferrer">{store.label} ↗</a>:<button class="button" disabled type="button" aria-label={`${store.label}: ${t.storeUnavailable}`}>{store.label} ↗</button>}</article>)}</div><p class="note">{t.storeNote} <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></p><div class="help-grid">{d.guides.slice(0,2).map(item=><article class="help-card"><h2>{item.title}</h2><p>{item.description}</p><a class="text-link" href={href(`/guides/${item.slug}/`)}>{t.readGuide} ↗</a></article>)}</div></section>}
  {path==='/guides/'&&<section class="container content-section"><div class="guide-grid">{d.guides.map(item=><a class="guide-card" href={href(`/guides/${item.slug}/`)}><span class="tag">{item.category} / {item.minutes} {t.minutes}</span><h2 style="font-size:1.35rem;margin-bottom:15px">{item.title}</h2><p>{item.description}</p><span class="read-more">{t.readGuide} ↗</span></a>)}</div></section>}
  {key==='faq'&&<section class="container content-section"><div class="faq-list">{d.faqs.map((item,i)=><details class="faq-item" open={i===0}><summary>{item.question}</summary><p>{item.answer}</p></details>)}<p class="note"><a class="text-link" href={href('/help/')}>{t.help} ↗</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p></div></section>}
  {key==='help'&&<section class="container content-section"><div class="help-grid">{d.guides.filter((_,i)=>[0,2,4,5].includes(i)).map(item=><article class="help-card"><h2>{item.title}</h2><p>{item.description}</p><a class="text-link" href={href(`/guides/${item.slug}/`)}>{t.readGuide} ↗</a></article>)}</div><div class="section split"><div><p class="eyebrow">TELL US WHAT HAPPENED</p><h2 style="margin:15px 0 20px">{t.contactTitle}</h2><a class="button" href={`mailto:${site.email}?subject=Node%20Comics%20Feedback`}>{t.emailButton} ↗</a><p class="muted" style="margin-top:20px">{site.email}</p></div><div class="help-card"><p>{t.contactDescription}</p></div></div></section>}
  {key==='about'&&<section class="container content-section split"><div class="prose"><blockquote class="about-quote">{t.tagline}</blockquote><p>{t.aboutBody}</p><a href={`mailto:${site.email}`}>{site.email}</a></div><div class="reading-art"><Image src={reading} width={760} format="webp" alt={t.readingAlt} loading="lazy"/></div></section>}
  {key==='changelog'&&<section class="container content-section"><a class="text-link" style="display:block;margin-bottom:35px" href={href('/feed.xml')}>{t.rss} ↗</a><div class="timeline">{d.releases.map(release=><article class="release" id={`release-${release.date}`}><time datetime={release.date}>{release.date}</time><h2>{release.title}</h2><ul>{release.items.map(item=><li>{item}</li>)}</ul></article>)}</div></section>}
  {['account','auth'].includes(key)&&<section class="container"><div class="account-shell"><Account client:load callback={key==='auth'} locale={locale} copy={account??{}} accountHref={href('/account/')} /><noscript><p class="note">{t.noscript}</p></noscript></div></section>}
  {['','features','about','guides'].includes(key)&&!guide&&<section class="container cta-section"><div><p class="eyebrow">YOUR NEXT CHAPTER</p><h2>{t.ctaTitle}</h2><p>{t.ctaDescription}</p></div><a class="button light" href={href('/download/')}>{t.ctaButton} ↗</a><span class="cta-star" aria-hidden="true">✦</span></section>}
</Base>
