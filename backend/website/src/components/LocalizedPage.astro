---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageIntro from './PageIntro.astro';
import HomePage from './HomePage.astro';
import FaqList from './FaqList.astro';
import ArticleSection from './ArticleSection.astro';
import MobilePlatforms from './MobilePlatforms.astro';
import { mobilePlatforms } from '../data/mobile';
import Account from './Account';
import BillingOffers from './BillingOffers';
import AboutProject from './AboutProject.astro';
import SupportChannels from './SupportChannels.astro';
import reading from '../assets/reading-corner.webp';
import {dictionaries,localPath,type Locale} from '../i18n';
import {homeCopy} from '../i18n/home';
import {site,absolute,browserStores} from '../data/site';
import {projectCopy} from '../i18n/project';
interface Props {locale:Locale;path:string}
const {locale,path}=Astro.props;
const {ui:t,documents:d,account}=dictionaries[locale];
const accountText=(key:string)=>account?.[key]??key;
const href=(target:string)=>localPath(target,locale);
const key=path.split('/')[1];
const guide=path.startsWith('/guides/')?d.guides.find(item=>`/guides/${item.slug}/`===path):undefined;
const mobileGuide=mobilePlatforms.some(platform=>platform.slug===guide?.slug);
const policy=d.policies[key];
const article=guide??policy;
const updated=guide?.updated??site.updated;
const relatedGuides=guide?.related ? guide.related.map(slug=>d.guides.find(item=>item.slug===slug)).filter((item):item is NonNullable<typeof item>=>!!item) : d.guides.filter(item=>item.slug!==guide?.slug).slice(0,3);
const featureGuides=['local-comics','remote-library','manga-translation','manga-translation','translation-modes','local-comics'];
const titles:Record<string,string>={features:t.seoFeaturesTitle,pricing:t.seoPricingTitle,download:t.seoDownloadTitle,guides:t.seoGuidesTitle,faq:t.seoFaqTitle,help:t.seoHelpTitle,about:t.seoAboutTitle,changelog:t.seoChangelogTitle,account:t.account,auth:t.callbackTitle};
const intros:Record<string,[string,string]>={features:[t.featureHeading,t.featureDescription],pricing:[t.pricingTitle,t.pricingDescription],download:[t.downloadTitle,t.downloadDescription],guides:[t.guidesTitle,t.guidesDescription],faq:[t.faqTitle,t.faqDescription],help:[t.helpTitle,t.helpDescription],about:[t.aboutTitle,t.aboutDescription],changelog:[t.changelogTitle,t.changelogDescription],account:[t.accountTitle,t.accountDescription],auth:[t.callbackTitle,t.callbackDescription]};
const title=path==='/'?t.seoHomeTitle:article?.title??titles[key]??t.seoHomeTitle;
const description=path==='/'?homeCopy[locale].description:article?.description??intros[key]?.[1]??homeCopy[locale].description;
const schema:Record<string,unknown>[]=[];
if(path==='/')schema.push({'@type':'SoftwareApplication','@id':absolute(`${href('/')}#software`),name:t.brandName,applicationCategory:'BrowserApplication',operatingSystem:'Windows, macOS, Linux',browserRequirements:'Desktop Chrome, Microsoft Edge or Mozilla Firefox',description,url:absolute(href('/')),installUrl:absolute(href('/download/')),sameAs:browserStores.filter(store=>store.url).map(store=>store.url),publisher:{'@id':absolute('/#organization')},inLanguage:locale,offers:{'@type':'Offer',price:'0',priceCurrency:'USD',description:homeCopy[locale].readerAccess,url:absolute(href('/pricing/'))}});
if(key==='faq')schema.push({'@type':'FAQPage','@id':absolute(href(path)),mainEntity:d.faqs.map(item=>({'@type':'Question','@id':absolute(`${href(path)}#${item.id}`),name:item.question,acceptedAnswer:{'@type':'Answer',text:item.answer}}))});
if(guide)schema.push({'@type':'Article',headline:guide.title,description:guide.description,datePublished:`${guide.published??site.updated}T00:00:00+08:00`,dateModified:`${updated}T00:00:00+08:00`,author:{'@type':'Organization',name:'NodeLane Comics',url:absolute(href('/about/'))},publisher:{'@id':absolute('/#organization')},mainEntityOfPage:absolute(href(path)),image:absolute('/social-cover.webp'),inLanguage:locale});
const stores=browserStores;
---
<Base title={title} description={description} schema={schema} noindex={['account','auth'].includes(key)}>
  {path==='/' ? <HomePage locale={locale}/> : <PageIntro eyebrow={guide?.category??'NODELANE COMICS / '+key.toUpperCase()} title={article?.title??intros[key]?.[0]??title} description={description}>{article&&<div class="meta"><span>{t.editor}</span><time datetime={updated}>{t.updated}: {updated}</time>{guide&&<span>{guide.minutes} {t.minutes}</span>}</div>}</PageIntro>}

  {mobileGuide&&<div class="container"><MobilePlatforms locale={locale} selected={guide?.slug}/></div>}

  {article&&<div class="container content-section prose-layout"><nav class="toc" aria-label={t.contents}><strong>{t.contents}</strong>{article.sections.map((section,i)=><a href={`#section-${i+1}`}>{section.title}</a>)}</nav><article class="prose">{article.sections.map((section,i)=><ArticleSection section={section} index={i} locale={locale}/>)}<aside class="note"><a href={href('/download/')}>{t.download}</a> · <a href={href('/pricing/')}>{t.pricing}</a> · <a href={href('/privacy/')}>{t.privacy}</a> · <a href={href('/help/')}>{t.help}</a></aside>{guide&&<div class="related"><h2>{t.related}</h2>{relatedGuides.map(item=><a href={href(`/guides/${item.slug}/`)}>{item.title} ↗</a>)}</div>}</article></div>}
  {key==='features'&&<><section class="container content-section"><div class="feature-grid">{t.featureTitles.map((item,i)=><article class="feature-card"><span class="number">0{i+1} / NODELANE COMICS</span><h2>{item}</h2><p style="margin-top:18px">{t.featureBodies[i]}</p><a class="text-link" href={href(`/guides/${featureGuides[i]}/`)}>{t.readGuide} ↗</a></article>)}</div></section><section class="reading-band"><div class="container section split"><div class="split-copy"><p class="eyebrow">A LITTLE LESS FRICTION</p><h2>{t.readingTitle}</h2><p>{t.readingDescription}</p><a class="text-link" href={href('/guides/local-comics/')}>{t.readGuide} ↗</a></div><div class="reading-art"><Image src={reading} width={720} format="webp" alt={t.readingAlt} loading="lazy"/></div></div></section><div class="section"></div></>}
  {key==='pricing'&&<section class="container content-section"><BillingOffers client:load locale={locale} accountHref={href('/account/')} downloadHref={href('/download/')} checkoutCopy={{busy:accountText('正在确认登录结果，请稍候…'),error:accountText('操作暂未完成，请重试或重新登录。'),before:accountText('继续前请阅读'),refund:accountText('订阅与退款说明'),renewal:accountText('，了解自动续费规则。'),resume:accountText('继续原结账')}} free={{name:t.freePlan,description:t.freePlanDescription,action:t.freeStart,note:t.freeNote,priceLabel:t.free}}/><div class="faq-list"><h2>{t.pricing}</h2><p class="note">{t.quotaNote}</p><a class="text-link" href={href('/refund/')}>{t.refund} ↗</a></div></section>}
  {key==='download'&&<section class="container content-section">
    <MobilePlatforms locale={locale}/>
    <div class="store-grid">{stores.map(store=>{const release=site.extensionPackages[store.id];return <article class="store-card" id={store.id} data-browser={store.id}>
      <img class="store-icon" src={store.icon} alt={store.name} width="48" height="48" loading="lazy"/>
      <h2>{store.name}</h2><p>{t.storeDescription}</p>
      <div class="store-actions">{store.url?<a class="button store-link" href={store.url} target="_blank" rel="noopener noreferrer">{store.label} ↗</a>:<p class="store-link store-pending">{store.label} · {t.storeUnavailable}</p>}
      {release&&<div class="platform-download">
        {release.download_url
          ? <a class="button secondary package-download" href={release.download_url} download={release.filename}
              aria-label={`${store.name} · ${store.id==='firefox'?t.downloadXpi:t.downloadZip}`}>
              {store.id==='firefox'?t.downloadXpi:t.downloadZip} ↓
            </a>
          : <span class="button secondary package-download-unavailable" aria-disabled="true">{t.packageUnavailable}</span>}
        <p class="package-meta">v{release.version} · {(release.bytes / 1024 / 1024).toFixed(2)} MB · {store.id==='firefox'?'XPI':'ZIP'}</p>
      </div>}</div>
    </article>})}</div>
    <article class="help-card download-install" aria-labelledby="manual-install-title"><div><h2 id="manual-install-title">{t.installTitle}</h2><p>{t.directDownloadDescription}</p><ol class="install-steps"><li>{t.installStepDownload}</li><li>{t.installStepBrowser}</li><li>{t.installStepLoad}</li></ol></div><p class="note">{t.manualUpdateNote}</p></article>
    <p class="note">{t.storeNote} <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></p>
    <div class="help-grid">{d.guides.slice(0,2).map(item=><article class="help-card"><h2>{item.title}</h2><p>{item.description}</p><a class="text-link" href={href(`/guides/${item.slug}/`)}>{t.readGuide} ↗</a></article>)}</div>
  </section>}
  {path==='/guides/'&&<section class="container content-section"><div class="guide-grid">{d.guides.map(item=><a class="guide-card" href={href(`/guides/${item.slug}/`)}><span class="tag">{item.category} / {item.minutes} {t.minutes}</span><h2 style="font-size:1.35rem;margin-bottom:15px">{item.title}</h2><p>{item.description}</p><span class="read-more">{t.readGuide} ↗</span></a>)}</div></section>}
  {key==='faq'&&<section class="container content-section"><nav class="faq-topics" aria-label={t.contents}>{d.faqs.map(item=><a href={`#${item.id}`}>{item.question}</a>)}</nav><FaqList locale={locale} items={d.faqs} headingLevel="h2"/><p class="note faq-contact"><a class="text-link" href={href('/help/')}>{t.help} ↗</a> · <a href={`mailto:${site.email}`}>{site.email}</a></p></section>}
  {key==='help'&&<section class="container content-section project-help">
    <MobilePlatforms locale={locale}/>
    <SupportChannels locale={locale}/>
    <section class="project-guides" aria-labelledby="support-guides-title">
      <h2 id="support-guides-title">{projectCopy[locale].guidesTitle}</h2>
      <div class="help-grid">{d.guides.filter((item,i)=>[0,2,4,5].includes(i)||['remote-library','local-translation','local-manga-translator'].includes(item.slug)).map(item=><article class="help-card"><h3>{item.title}</h3><p>{item.description}</p><a class="text-link" href={href(`/guides/${item.slug}/`)}>{t.readGuide} ↗</a></article>)}</div>
    </section>
    <aside class="project-feedback-note"><h2>{t.contactTitle}</h2><p>{t.contactDescription}</p></aside>
  </section>}
  {key==='about'&&<AboutProject locale={locale}/>}
  {key==='changelog'&&<section class="container content-section"><a class="text-link" style="display:block;margin-bottom:35px" href={href('/feed.xml')}>{t.rss} ↗</a><div class="timeline">{d.releases.map(release=><article class="release" id={`release-${release.id ?? release.date}`}><time datetime={release.date}>{release.date}</time><h2>{release.title}</h2><ul>{release.items.map(item=><li>{item}</li>)}</ul></article>)}</div></section>}
  {['account','auth'].includes(key)&&<section class="container"><div class="account-shell"><Account client:load callback={key==='auth'} locale={locale} copy={account??{}} accountHref={href('/account/')} /><noscript><p class="note">{t.noscript}</p></noscript></div></section>}
  {['features','about','guides'].includes(key)&&!guide&&<section class="container cta-section"><div><p class="eyebrow">YOUR NEXT CHAPTER</p><h2>{t.ctaTitle}</h2><p>{t.ctaDescription}</p></div><a class="button light" data-install-extension href={href('/download/')}>{t.ctaButton} ↗</a><span class="cta-star" aria-hidden="true">✦</span></section>}
</Base>
<style>
  .prose { min-width: 0; font-size: 1rem; }
  .meta { flex-wrap: wrap; }
</style>
