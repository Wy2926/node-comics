---
import {Image} from 'astro:assets';
import logoZh from '../assets/logo-zh-dark.webp';
import logoEn from '../assets/logo-en-dark.webp';
import LanguageFlag from '../components/LanguageFlag.astro';
import LanguageNotice from '../components/LanguageNotice.astro';
import { site, absolute } from '../data/site';
import { dictionaries, localeFromPath, basePath, localPath, locales, languageNames, type Locale } from '../i18n';
import '../styles/global.css';
import '../styles/controls.css';
import '../styles/header.css';
import '../styles/public-site.css';
import '../styles/marketing.css';
import '../styles/rtl.css';
import {translationCopy} from '../i18n/translate';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  image?: string;
}
const { title, description, noindex = false, schema = [], image = '/social-cover.webp' } = Astro.props;
const path = Astro.url.pathname;
const locale=localeFromPath(path);
const route=basePath(path);
const t=dictionaries[locale].ui;
const href=(target:string)=>localPath(target,locale);
const navigation=[{href:href('/features/'),label:t.features},{href:href('/pricing/'),label:t.pricing},{href:href('/help/'),label:t.help}];
const pageLanguages = locales;
const canonical = absolute(path);
const pageTitle = route === '/' ? title : `${title} · ${t.brandName}`;
const pageSchema = schema.find(item => item['@id'] === canonical);
const ogLocales: Record<Locale,string> = {"zh-CN": "zh_CN", "zh-TW": "zh_TW", "en": "en_US", "ja": "ja_JP", "ko": "ko_KR", "fr": "fr_FR", "es": "es_ES", "pt-BR": "pt_BR", "de": "de_DE", "it": "it_IT", "ru": "ru_RU", "pl": "pl_PL", "uk": "uk_UA", "tr": "tr_TR", "vi": "vi_VN", "id": "id_ID", "ar": "ar_AR"};
const graph = [
  { '@type': 'Organization', '@id': absolute('/#organization'), name: site.name, url: site.url, email: site.email, logo: absolute('/icon-128.png'), sameAs: [site.github, site.youtube], contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: site.email } },
  { '@type': 'WebSite', '@id': absolute('/#website'), url: site.url, name: site.name, alternateName: ['NodeLane 漫译', 'NodeLane 漫譯'], inLanguage: locales, publisher: { '@id': absolute('/#organization') } },
  { '@type': 'WebPage', '@id': canonical, url: canonical, name: pageTitle, description, inLanguage: locale, isPartOf: { '@id': absolute('/#website') }, ...pageSchema },
  ...(route !== '/' ? [{ '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: t.home, item: absolute(href('/')) }, ...(route.startsWith('/guides/') && route !== '/guides/' ? [{ '@type': 'ListItem', position: 2, name: t.guides, item: absolute(href('/guides/')) }] : []), { '@type': 'ListItem', position: route.startsWith('/guides/') && route !== '/guides/' ? 3 : 2, name: title, item: canonical }] }] : []),
  ...schema.filter(item => item !== pageSchema),
];
---
<!doctype html>
<html lang={locale} dir={locale === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080f19" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="referrer" content="no-referrer" />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    {!noindex && <>{locales.map(language => <link rel="alternate" hreflang={language} href={absolute(localPath(route,language))} />)}<link rel="alternate" hreflang="x-default" href={absolute(route)} /></>}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${t.brandName} ${t.changelog}`} href={href("/feed.xml")} />
    <meta property="og:type" content={route.startsWith('/guides/') && route !== '/guides/' ? 'article' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {pageLanguages.filter(language => language !== locale).map(language => <meta property="og:locale:alternate" content={ogLocales[language]} />)}
    <meta property="og:image" content={absolute(image)} />
    <meta property="og:image:alt" content={t.ogAlt} />
    {image === '/social-cover.webp' && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:type" content="image/webp" /></>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absolute(image)} />
    <meta name="twitter:image:alt" content={t.ogAlt} />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c')} />
  </head>
  <body data-install-stores={JSON.stringify(site.stores)} data-page={route} data-site-theme="midnight">
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={href('/')} aria-label={t.brandName}><Image src={locale.startsWith('zh')?logoZh:logoEn} alt={t.brandName} width={240} format="webp" loading="eager" /></a>
        <nav class="desktop-nav" aria-label={t.navigation}>{navigation.map(item => <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}</nav>
        <div class="header-tools"><a class="button header-download" data-install-extension href={href('/download/')}>{t.download}</a><details class="language-menu" name="header-menu"><summary aria-label={`${t.language}: ${languageNames[locale]}`}><LanguageFlag locale={locale}/><span>{languageNames[locale]}</span><svg class="language-chevron" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></summary><nav aria-label={t.language}>{pageLanguages.map(language=><a href={localPath(route.startsWith('/404') ? '/' : route,language)} lang={language} dir={language === 'ar' ? 'rtl' : 'ltr'} hreflang={language} aria-current={locale===language ? "true" : undefined}><LanguageFlag locale={language}/><span>{languageNames[language]}</span></a>)}</nav></details>
        <div class="header-actions"><a class="account-link" href={href('/account/')} aria-label={t.account} title={t.account} aria-current={route === '/account/' ? 'page' : undefined}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg><span>{t.account}</span></a></div>
        <details class="mobile-nav" name="header-menu"><summary aria-label={t.menu}><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h12M4 18h16"/></svg></summary><nav aria-label={t.mobileNavigation}>{navigation.map(item => <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}<a href={href('/account/')} aria-current={route === '/account/' ? 'page' : undefined}>{t.account}</a><a class="mobile-download" data-install-extension href={href('/download/')}>{t.download} <span aria-hidden="true">↗</span></a></nav></details></div>
      </div>
    </header>
    <LanguageNotice locale={locale} enabled={!noindex}/>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-top">
        <div><a class="brand" href={href('/')}><Image src={locale.startsWith('zh')?logoZh:logoEn} alt={t.brandName} width={220} format="webp" loading="lazy" /></a><p>{t.footerStory}</p><a class="email" href={`mailto:${site.email}`}>{site.email} ↗</a></div>
        <div><strong>{t.startReading}</strong><a href={href('/features/')}>{t.features}</a><a href={href('/download/')}>{t.download}</a><a href={href('/pricing/')}>{t.pricing}</a><a href={href('/translate/')}>{translationCopy[locale].open}</a><a href={href('/account/')}>{t.account}</a></div>
        <div><strong>{t.support}</strong><a href={href('/guides/')}>{t.guides}</a><a href={href('/faq/')}>{t.faq}</a><a href={href('/help/')}>{t.help}</a><a href={href('/changelog/')}>{t.changelog}</a></div>
        <div><strong>{t.company}</strong><a href={href('/about/')}>{t.about}</a><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a><a href={site.youtube} target="_blank" rel="noopener noreferrer">YouTube <span aria-hidden="true">↗</span></a><a href={href('/privacy/')}>{t.privacy}</a><a href={href('/terms/')}>{t.terms}</a><a href={href('/refund/')}>{t.refund}</a></div>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} {t.brandName}. {t.copyright}</span><span>{t.artNote}</span><a href={href('/feed.xml')}>RSS ↗</a></div>
    </footer>
    <script>
      import { browserStoreUrl } from '../lib/browser-store';
      const stores = JSON.parse(document.body.dataset.installStores ?? '{}');
      const destination = browserStoreUrl(navigator, stores);
      if (destination) {
        const update = (link: HTMLAnchorElement) => { link.href = destination; };
        document.querySelectorAll<HTMLAnchorElement>('a[data-install-extension]').forEach(link => {
          // Do not mutate server-rendered React props before hydration.
          if (!link.closest('astro-island')) update(link);
        });
        // Capture also covers links replaced by an account/pricing React island.
        const onInstall = (event: Event) => {
          const link = event.target instanceof Element
            ? event.target.closest<HTMLAnchorElement>('a[data-install-extension]') : null;
          if (link) update(link);
        };
        document.addEventListener('click', onInstall, true);
        document.addEventListener('auxclick', onInstall, true);
        document.addEventListener('contextmenu', onInstall, true);
      }
    </script>
  </body>
</html>
