# 服务商配置仅进入后端容器，绝不能复制到插件 public 或 VITE_ 变量。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-2
# 各模型可选参数由后端 profile 控制，默认只传必要字段。
# PROVIDERS_JSON=[]
# 生产环境关闭本地测试登录并配置以下 OIDC 项，完整说明见 docs/IMPLEMENTATION.md。
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URL=
# OIDC_CLIENT_ID=
# OIDC_AUTHORIZATION_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=

# 两种模式各自独立的账户在途/实时名额；权重按实际占用时长校正。
FREE_QUEUE_CAPACITY=10
PLUS_QUEUE_CAPACITY=500
FREE_REALTIME_SLOTS=2
PLUS_REALTIME_SLOTS=10
FREE_SCHEDULER_WEIGHT=1
PLUS_SCHEDULER_WEIGHT=2
REALTIME_SHARE=0.9
PRIORITY_TTL_SECONDS=90
CLUSTER_LEASE_SECONDS=90
CLUSTER_TEXT_SLOTS=4
CLUSTER_REDRAW_SLOTS=4
CLUSTER_UPLOAD_SLOTS=2
CLUSTER_TEXT_REQUESTS_PER_MINUTE=60
# 只计已 OCR、尚未抹字的活跃预存页；等待 LLM 的已抹字页不阻塞图像设备。
CLUSTER_MAX_IMAGE_STAGES=64
FREE_DAILY_PAGES=100
PLUS_MONTHLY_REDRAW_PAGES=300
QUOTA_TIMEZONE=Asia/Shanghai
# 全新集群数据库与独立Compose项目；不迁移旧任务/旧批次数据。
POSTGRES_DB=nodecomics_cluster
# 在后台添加节点；将返回的 NODE_ID、独立 NODE_TOKEN 写入 deploy/.env.local。

# 常规翻译：./scripts/bootstrap.ps1 -Start -Classic
# 引擎令牌由 bootstrap 写入 deploy/.env.local，不给引擎提供文本模型密钥。
CLASSIC_ENABLED=false
# Windows AMD 原模型节点使用 mit-directml；本机启动脚本自动设置。
ENGINE_DICTIONARY_LANGUAGES=en
TEXT_BASE_URL=https://your-text-provider.example/v1
TEXT_API_KEY=
TEXT_MODEL=gpt-5.6-luna
TEXT_PROTOCOL=openai_chat
# 以下为运营估价，并非供应商价目；micro-CNY 为百万分之一元。
TEXT_INPUT_RATE=5
TEXT_OUTPUT_RATE=30
TEXT_PRICING_VERSION=operator-estimate-v1
TEXT_MAX_ATTEMPTS=3
TEXT_MAX_OUTPUT_TOKENS=1024

# 原图与最终译图均使用私有 R2。部署必填；local 仅允许隔离测试。
RESULT_STORAGE_BACKEND=r2
# 0 表示原图与译图无限期保留，未来可基于最近访问时间扩展清理。
RETENTION_DAYS=0
# R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_BUCKET=node-comics-private
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_KEY_PREFIX=node-comics/
STORAGE_URL_TTL_SECONDS=300
STORAGE_TIMEOUT_SECONDS=30
