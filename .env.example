# Private admin entry, e.g. /console-<random-32-hex>/; empty disables admin pages.
# Register https://<host><ADMIN_WEB_PATH> in Logto; keep extension redirect URIs.
ADMIN_WEB_PATH=
# 服务商配置仅进入后端容器，绝不能复制到插件 public 或 VITE_ 变量。
APP_ENV=production
DEV_AUTH=false
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-2
# 各模型可选参数由后端 profile 控制，默认只传必要字段。
# PROVIDERS_JSON=[]
# 生产环境必须配置以下 OIDC 项及精确来源，见 docs/PRODUCTION_IDENTITY.md。
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URL=
# OIDC_CLIENT_ID=
# OIDC_AUTHORIZATION_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=

# 滚动 60 秒内新增翻译图片；仅首次初始化，之后在后台系统设置修改。
FREE_IMAGES_PER_MINUTE=30
PLUS_IMAGES_PER_MINUTE=100
# 控制请求保护独立于图片分钟额度；不限制账户待处理任务数。
PLAN_REQUESTS_PER_MINUTE=300
PLAN_REQUEST_BURST=30
PLAN_REQUEST_CONCURRENCY=4
FREE_SCHEDULER_WEIGHT=1
PLUS_SCHEDULER_WEIGHT=2
REALTIME_SHARE=0.9
PRIORITY_TTL_SECONDS=90
CLUSTER_LEASE_SECONDS=90
CLUSTER_TEXT_SLOTS=4
CLUSTER_REDRAW_SLOTS=4
CLUSTER_UPLOAD_SLOTS=2
# 以下仅用于首次创建统一系统设置；创建后在后台修改，重启不会覆盖。
UPLOAD_USER_CONCURRENCY=10
UPLOAD_GLOBAL_CONCURRENCY=16
UPLOAD_IDLE_TIMEOUT_SECONDS=15
UPLOAD_BODY_TIMEOUT_SECONDS=120
UPLOAD_INGRESS_LEASE_SECONDS=45
FEEDBACK_REQUESTS_PER_MINUTE=30
FEEDBACK_REQUEST_BURST=10
FEEDBACK_RECEIPTS_PER_DAY=100
FREE_DAILY_PAGES=100
PLUS_MONTHLY_REDRAW_PAGES=300
QUOTA_TIMEZONE=Asia/Shanghai
# Stripe 官方托管支付，默认关闭。测试与正式收款必须使用独立数据库。
# 配置与 Webhook/Customer Portal 设置见 docs/STRIPE_BILLING.md。
STRIPE_ENABLED=false
STRIPE_ENVIRONMENT=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_RETURN_URL=https://comics.nodelane.net/account/

# 全新集群数据库与独立Compose项目；不迁移旧任务/旧批次数据。
POSTGRES_DB=nodecomics_cluster
# 在后台添加节点，将返回的独立身份写入计算代理私有配置。

# 常规翻译需单独接入图像引擎；仓库只提供控制服务与计算代理。
CLASSIC_ENABLED=false
# 必须与接入节点报告的版本一致；引擎负责将影响结果的配置纳入此版本。
CLASSIC_ENGINE_VERSION=external-v1
# 启动后在 <ADMIN_WEB_PATH>#translation-providers 创建文本供应商，首个自动成为默认。
# 模型、协议、密钥、重试、估价和每供应商 RPM 均存 DB；不从环境变量初始化。
# 支持 OpenAI Chat Completions（默认）和 Responses；模型/协议/密钥及默认选择只影响新任务。
# 启停和 RPM 对该供应商各版本统一生效。详见 docs/TRANSLATION_PROVIDERS.md。
# 数据库及备份包含敏感供应商密钥，必须限制访问权限。

# 原图与最终译图均使用私有 R2。部署必填；local 仅允许隔离测试。
RESULT_STORAGE_BACKEND=r2
# 0 表示原图与译图无限期保留，未来可基于最近访问时间扩展清理。
RETENTION_DAYS=0
# R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_BUCKET=node-comics-private
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_KEY_PREFIX=node-comics/
STORAGE_URL_TTL_SECONDS=300
STORAGE_TIMEOUT_SECONDS=30
