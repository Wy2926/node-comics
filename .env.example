# 服务商配置仅进入后端容器，绝不能复制到插件 public 或 VITE_ 变量。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-2
# 各模型可选参数由后端 profile 控制，默认只传必要字段。
# PROVIDERS_JSON=[]
# 生产环境关闭本地测试登录并配置以下 OIDC 项，完整说明见 docs/IMPLEMENTATION.md。
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URL=
# OIDC_CLIENT_ID=
# OIDC_AUTHORIZATION_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=

# 后端按用户公平轮转；单页、多个批次和两种翻译模式共享名额。
USER_QUEUE_CONCURRENCY=2
USER_QUEUE_MAX_CONCURRENCY=10
DISPATCH_MAX_JOBS=100
QUEUE_REPUBLISH_SECONDS=60

# 常规翻译：./scripts/bootstrap.ps1 -Start -Classic
# 引擎令牌由 bootstrap 写入 deploy/.env.local，不给引擎提供文本模型密钥。
CLASSIC_ENABLED=false
CLASSIC_COST=1
TEXT_BASE_URL=https://your-text-provider.example/v1
TEXT_API_KEY=
TEXT_MODEL=gpt-5.6-luna
TEXT_PROTOCOL=openai_chat
# 以下为运营估价，并非供应商价目；micro-CNY 为百万分之一元。
TEXT_PAGE_BUDGET_MICROS=50000
TEXT_INPUT_RATE=5
TEXT_OUTPUT_RATE=30
TEXT_PRICING_VERSION=operator-estimate-v1
TEXT_MAX_ATTEMPTS=3
TEXT_MAX_OUTPUT_TOKENS=1024
