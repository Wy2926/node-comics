# Private admin entry, e.g. /console-<random-32-hex>/; empty disables admin pages.
# Register https://<host><ADMIN_WEB_PATH> in Logto; keep extension redirect URIs.
ADMIN_WEB_PATH=
# 服务商配置仅进入后端容器，绝不能复制到插件 public 或 VITE_ 变量。
APP_ENV=production
# Redis 8：全部 API/worker 共用；不同环境使用独立实例或不同命名空间。
# Compose 内部地址；直接运行 Python 时改为 redis://127.0.0.1:6379/0。
REDIS_URL=redis://redis:6379/0
REDIS_NAMESPACE=node-comics
REDIS_MAX_MEMORY=256mb
DEV_AUTH=false
# 官网匿名体验默认关闭；所有密钥只在后端。生产不得使用 Turnstile 测试密钥。
GUEST_ENABLED=false
GUEST_ORIGIN=https://comics.nodelane.net
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 独立随机密钥，至少 32 字符；所有 API 槽位一致，不随发布轮换。
GUEST_HASH_SECRET=
GUEST_DAILY_LIMIT=5
GUEST_NETWORK_DAILY_LIMIT=100
GUEST_GLOBAL_DAILY_LIMIT=10000
GUEST_GLOBAL_CONCURRENCY=4
# 仅插件自愿启用后的产品分析；官网不采集。API secret 只能保留在后端。
GA4_ENABLED=false
# 仅隔离 development/test 服务可开启 DebugView 标记；production 开启会拒绝启动。
GA4_DEBUG_MODE=false
GA4_EXTENSION_MEASUREMENT_ID=
GA4_EXTENSION_API_SECRET=
# 生产环境必须配置以下 OIDC 项及精确来源，见 docs/PRODUCTION_IDENTITY.md。
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URL=
# OIDC_CLIENT_ID=
# OIDC_AUTHORIZATION_ENDPOINT=
# OIDC_TOKEN_ENDPOINT=

# 滚动 60 秒内新增翻译图片；仅首次初始化，之后在后台系统设置修改。
FREE_IMAGES_PER_MINUTE=10
PLUS_IMAGES_PER_MINUTE=100
# 控制请求保护独立于图片分钟额度；不限制账户待处理任务数。
TRANSLATION_REQUESTS_PER_MINUTE=300
TRANSLATION_REQUEST_BURST=30
TRANSLATION_REQUEST_CONCURRENCY=4
REALTIME_SHARE=0.9
PRIORITY_TTL_SECONDS=90
CLUSTER_LEASE_SECONDS=90
CLUSTER_TEXT_SLOTS=4
CLUSTER_UPLOAD_SLOTS=2
# 以下仅用于首次创建统一系统设置；创建后在后台修改，重启不会覆盖。
UPLOAD_USER_CONCURRENCY=10
UPLOAD_GLOBAL_CONCURRENCY=16
UPLOAD_IDLE_TIMEOUT_SECONDS=15
UPLOAD_BODY_TIMEOUT_SECONDS=120
UPLOAD_INGRESS_LEASE_SECONDS=45
FEEDBACK_REQUESTS_PER_MINUTE=30
FEEDBACK_REQUEST_BURST=10
FEEDBACK_RECEIPTS_PER_DAY=100
FREE_DAILY_PAGES=30
QUOTA_TIMEZONE=Asia/Shanghai
# Stripe / Creem 官方托管支付，默认均关闭。测试与正式收款必须使用独立数据库。
# 配置与 Webhook/Customer Portal 设置见 docs/STRIPE_BILLING.md。
# 开启渠道时必须同时配置 API 密钥、Webhook 验签密钥和 HTTPS 返回页；已启用渠道使用相同环境。
STRIPE_ENABLED=false
STRIPE_ENVIRONMENT=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_RETURN_URL=https://comics.nodelane.net/account/
CREEM_ENABLED=false
CREEM_ENVIRONMENT=test
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_RETURN_URL=https://comics.nodelane.net/account/

# 全新集群数据库与独立Compose项目；不迁移旧任务/旧批次数据。
POSTGRES_DB=nodecomics_cluster
# 在后台添加节点，将返回的独立身份写入计算代理私有配置。

# 常规翻译需单独接入图像引擎；仓库只提供控制服务与计算代理。
CLASSIC_ENABLED=false
# 必须与接入节点报告的版本一致；引擎负责将影响结果的配置纳入此版本。
# 启动后在 <ADMIN_WEB_PATH>#translation-providers 创建文本供应商，首个自动成为默认。
# 模型、协议、密钥、重试、估价和每供应商 RPM 均存 DB；不从环境变量初始化。
# 支持 OpenAI Chat Completions（默认）和 Responses；模型/协议/密钥及默认选择只影响新任务。
# 启停和 RPM 对该供应商各版本统一生效。详见 docs/TRANSLATION_PROVIDERS.md。
# 数据库及备份包含敏感供应商密钥，必须限制访问权限。

# 单中心共享持久卷：原图仅任务在途保留，结果长期保留。
# API、control-worker、maintenance 必须读取同一路径。
STORAGE_PATH=./private-data
CLUSTER_RESULT_INGRESS_CONCURRENCY=4
CLUSTER_MAX_RESULT_BYTES=92274688
