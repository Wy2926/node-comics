# Private admin entry, e.g. /console-<random-32-hex>/; empty disables admin pages.
# Register https://<host><ADMIN_WEB_PATH> in Logto; keep extension redirect URIs.
ADMIN_WEB_PATH=
# Copy to .env.server next to compose.server.yaml; chmod 600 on the VPS.
# Compose interpolation (SERVER_IMAGE / INFRA_NETWORK / API_PORT) lives in .env.
APP_ENV=production
DEV_AUTH=false
# Consented extension analytics only; never expose the API secret to the extension.
GA4_ENABLED=false
GA4_EXTENSION_MEASUREMENT_ID=
GA4_EXTENSION_API_SECRET=
DATABASE_URL=postgresql+psycopg://nodecomics_production:REPLACE_PASSWORD@1Panel-postgresql-puHh:5432/nodecomics_production
REDIS_URL=redis://redis:6379/0
REDIS_NAMESPACE=node-comics-production
OIDC_CLIENT_ID=dept2iz42nzidf5pao6fo
OIDC_ISSUER=https://auth.nodelane.net/oidc
OIDC_AUTHORIZATION_ENDPOINT=https://auth.nodelane.net/oidc/auth
OIDC_TOKEN_ENDPOINT=https://auth.nodelane.net/oidc/token
OIDC_JWKS_URL=https://auth.nodelane.net/oidc/jwks
OIDC_AUDIENCE=https://comics.nodelane.net/api
OIDC_ADMIN_ROLE=node-comics-admin
CORS_ORIGINS=https://comics.nodelane.net
EXTENSION_IDS=aiajdjliifeeaogpalejpggkiccjbneo
# Enable only after connecting an independently deployed compatible image engine.
CLASSIC_ENABLED=false
# After startup, create a text supplier at <ADMIN_WEB_PATH>#translation-providers.
# The first supplier becomes default. Model, protocol, key and per-supplier RPM live in DB.
# OpenAI Chat Completions (default) and Responses are supported; no environment seed/import.
# Database and backups contain sensitive supplier keys: restrict access to both.
# Optional image-redraw provider. An empty key leaves this provider disabled.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-2
# API / worker / maintenance share the same durable translation_files volume.
STORAGE_PATH=/data/translation
