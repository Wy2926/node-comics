location = /@NGINXPULSE_BASE_PATH@ { return 308 /@NGINXPULSE_BASE_PATH@/; }
location ^~ /@NGINXPULSE_BASE_PATH@/ {
    auth_basic "NginxPulse (administrator only)";
    auth_basic_user_file /etc/nodelane/nginxpulse.htpasswd;
    # Basic Auth is ambient browser authority; require same-origin writes.
    if ($pulse_write_allowed = 0) { return 403; }
    access_log off;
    proxy_pass http://127.0.0.1:@NGINXPULSE_PORT@;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    # The dedicated edge password must not reach the application or its logs.
    proxy_set_header Authorization "";
    proxy_read_timeout 120s;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "private, no-store" always;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
}
