# Copy to a private env file and pass with docker compose --env-file.
# Generate the database password with openssl rand -hex 32; never commit it.
# Put the same password in the private nginxpulse_config.json database.dsn.
NGINXPULSE_DB_PASSWORD=
# Dashboard URL = origin + /base-path/. Render the proxy after changing these.
NGINXPULSE_ORIGIN=https://comics.nodelane.net
NGINXPULSE_BASE_PATH=traffic
NGINXPULSE_PORT=18090
NGINXPULSE_UID=10002
# Set to the host log-reader group ID (Debian/Ubuntu adm is usually 4).
NGINXPULSE_GID=4
NGINXPULSE_LOG_DIRECTORY=/var/log/nginx/nginxpulse
NGINXPULSE_CONFIG_DIRECTORY=/etc/nodelane/nginxpulse
