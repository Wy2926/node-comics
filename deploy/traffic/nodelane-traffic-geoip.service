[Unit]
Description=Update local DB-IP Lite City and ASN databases
[Service]
Type=oneshot
User=nodelane-traffic
Group=www-data
UMask=0027
ExecStart=/usr/bin/python3 /usr/local/lib/nodelane-traffic/traffic.py geoip
Nice=10
MemoryMax=256M
TimeoutStartSec=10min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/nodelane-traffic
