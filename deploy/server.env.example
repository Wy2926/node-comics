# Copy to .env next to compose.server.yaml. Use immutable release tags/digests.
BLUE_IMAGE=node-comics-backend:REPLACE_RELEASE
GREEN_IMAGE=node-comics-backend:REPLACE_RELEASE
WORKER_IMAGE=node-comics-backend:REPLACE_RELEASE
MAINTENANCE_IMAGE=node-comics-backend:REPLACE_RELEASE
MIGRATION_IMAGE=node-comics-backend:REPLACE_RELEASE
BLUE_PORT=18088
GREEN_PORT=18089
INFRA_NETWORK=1panel-network
# Inspect the current mount; never create an empty replacement during an upgrade.
TRANSLATION_VOLUME=REPLACE_EXISTING_VOLUME
