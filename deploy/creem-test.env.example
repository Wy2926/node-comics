# Copy to deploy/.env.creem-test (gitignored); restrict it to the local account.
# Never copy production provider/storage keys or point at an existing database.
POSTGRES_PASSWORD=replace-with-a-new-random-password
OIDC_CLIENT_ID=
OIDC_ISSUER=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
CORS_ORIGINS=http://127.0.0.1:28088
# Keep disabled until the test webhook has been created and verified.
CREEM_ENABLED=false
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_RETURN_URL=https://replace-with-current-tunnel/payment/success/
CREEM_TEST_WEBHOOK_ID=
CREEM_TEST_MONTH_PRODUCT_ID=
CREEM_TEST_YEAR_PRODUCT_ID=
CREEM_TEST_PERMANENT_PRODUCT_ID=
CREEM_TEST_EXPIRING_PRODUCT_ID=
